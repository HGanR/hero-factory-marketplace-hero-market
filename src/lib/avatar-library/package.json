{
  "name": "avatar-creator-library",
  "version": "1.0.0",
  "description": "Comprehensive 3D avatar creation library for web — body, face, hair, clothing, jewelry, footwear, and more.",
  "type": "module",
  "main": "src/AvatarCreator.js",
  "exports": {
